# Supabase transaction-pooler URI; use SSL and keep credentials server-side.
DATABASE_URL=postgres://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# A stable random secret used only to hash client IPs for the shared lookup limiter.
COUPON_LOOKUP_HMAC_KEY=replace-with-a-long-random-secret

# Public URL used to build links embedded in issued QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Nominatim contact identity for address lookups.
BONOS_GEOCODER_USER_AGENT=ElHierroPremia/1.0 (contact@example.com)

# Opcional: avisos instantáneos de Supabase Realtime. Son valores públicos (Project Settings > API).
# Sin ellos la web se actualiza igualmente por comprobación periódica (cada pocos segundos).
# En Realtime > Settings debe estar activado "Allow public access" para canales de difusión.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
